# Copy this file to .env. Paste a REAL proxy URI from Dashboard > Generate.
# Choose protocol_auth_host_port in the generator for a ready-to-use URI.
XPROXY_URL=http://USERNAME:PASSWORD@HOST:PORT

# This checks the exit IP. For location data, use https://ipinfo.io/json instead.
XPROXY_TEST_URL=https://api.ipify.org?format=json
XPROXY_TIMEOUT=20

# Optional: used only by the proxy-list API example. This is not your login key.
# XPROXY_API_KEY=YOUR_API_KEY

# Optional: use an already installed Chromium instead of Playwright's download.
# XPROXY_BROWSER_PATH=/usr/bin/chromium
